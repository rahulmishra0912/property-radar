{
  "name": "property-radar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "tsx scripts/ensure-db.ts",
    "dev": "next dev --turbopack",
    "prebuild": "tsx scripts/ensure-db.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "setup": "tsx scripts/ensure-db.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:refresh": "tsx scripts/refresh-properties.ts",
    "db:reset": "npx prisma db push --force-reset && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.14",
    "typescript": "^5"
  }
}
