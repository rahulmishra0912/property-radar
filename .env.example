# SQLite file is created next to prisma/schema.prisma (prisma/dev.db)
DATABASE_URL="file:./dev.db"

# Optional: set to a Postgres URL later
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/property_radar"

# Midnight IST in-process scheduler (set to 0 to disable)
# INGEST_SCHEDULE=0

# Required in production for GET/POST /api/ingestion/run and Vercel Cron
# CRON_SECRET="replace-me"

# GitHub Pages static export (also set automatically by npm run build:pages)
# GITHUB_PAGES=1
# NEXT_PUBLIC_STATIC_HOST=1
# NEXT_PUBLIC_BASE_PATH=/property-radar
# NEXT_PUBLIC_SITE_URL=https://rahulmishra0912.github.io/property-radar

